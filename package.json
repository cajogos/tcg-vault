{
  "name": "tcg-vault",
  "version": "1.0.0",
  "description": "A Pokemon TCG Vault to store card information, values, conditions and eBay listings.",
  "main": "index.js",
  "scripts": {
    "db:load": "tsx src/backend/scripts/db-load.ts",
    "db:save": "tsx src/backend/scripts/db-save.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "cli:add": "tsx src/backend/scripts/cli-add.ts",
    "db:backfill-symbols": "tsx src/backend/scripts/backfill-set-symbols.ts",
    "images:sync": "tsx src/backend/scripts/download-images.ts",
    "dev": "pnpm db:load && vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
